{
  "name": "rowan",
  "version": "0.1.0",
  "private": true,
  "description": "Rowan - an indie 2D game engine and editor that runs natively in the browser.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @rowan/runtime && npm run dev -w @rowan/editor",
    "build": "npm run build -w @rowan/core && npm run build -w @rowan/runtime && npm run build -w @rowan/editor",
    "preview": "npm run preview -w @rowan/editor",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "docs:generate": "node scripts/generateScriptDocs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
